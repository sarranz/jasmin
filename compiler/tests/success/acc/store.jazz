export
fn store(reg u32 arg0) {
    [#aligned arg0] = arg0;
    [#aligned arg0 + 1] = arg0;
    [#aligned arg0 - 1] = arg0;
    [#aligned arg0 + 2047] = arg0;
    [#aligned arg0 - 2048] = arg0;

    stack u32 s;
    s = arg0;
    arg0 = s;
    [#aligned arg0] = arg0;

    stack u32[1] s;
    s[#aligned 0] = arg0;
    arg0 = s[#aligned 0];
    [#aligned arg0] = arg0;
}
