// Logical shifts of u256 registers by a constant amount.
//
// ACC has no plain wide shift; lowering uses BN.RSHI (concatenate and shift
// right) with a zeroed fresh register:
//   z = x >> i   becomes   tmp = #set0_256(); z = #BN_RSHI(tmp, x, i);
//   z = x << i   becomes   tmp = #set0_256(); z = #BN_RSHI(x, tmp, 256 - i);
// A shift by zero is a BN.MOV, which disappears when source and destination
// are allocated to the same register.
// The amount must be a constant (see fail/acc/bn_shift_variable_amount.jazz).

export
fn shr_8(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi w0, t, w0 >> 8
    reg u256 z;
    z = x >> 8;
    return z;
}

export
fn shl_8(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi w0, w0, t >> 248
    reg u256 z;
    z = x << 8;
    return z;
}

export
fn shr_in_place(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi w0, t, w0 >> 16
    x = x >> 16;
    return x;
}

export
fn shl_in_place(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi w0, w0, t >> 240
    x = x << 16;
    return x;
}

export
fn shr_other(reg u256 a, reg u256 b) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi w0, t, w1 >> 64
    a = b >> 64;
    return a;
}

export
fn shl_other(reg u256 a, reg u256 b) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi w0, w1, t >> 192
    a = b << 64;
    return a;
}

// Unlike the shifted operand of BN.CMP and friends, the amount does not have
// to be a multiple of 8.
export
fn shr_1(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi w0, t, w0 >> 1
    x = x >> 1;
    return x;
}

export
fn shl_1(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi w0, w0, t >> 255
    x = x << 1;
    return x;
}

export
fn shr_3(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi w0, t, w0 >> 3
    x = x >> 3;
    return x;
}

export
fn shl_3(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi w0, w0, t >> 253
    x = x << 3;
    return x;
}

export
fn shr_255(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi w0, t, w0 >> 255
    x = x >> 255;
    return x;
}

export
fn shl_255(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi w0, w0, t >> 1
    x = x << 255;
    return x;
}

// Shift by zero to a different register: a move.
export
fn shr_0_other(reg u256 a, reg u256 b) -> reg u256 {
    // bn.mov w0, w1
    a = b >> 0;
    return a;
}

export
fn shl_0_other(reg u256 a, reg u256 b) -> reg u256 {
    // bn.mov w0, w1
    a = b << 0;
    return a;
}

// Shift by zero to the same register: nothing.
export
fn shr_0_same(reg u256 x) -> reg u256 {
    // (no instruction)
    x = x >> 0;
    return x;
}

export
fn shl_0_same(reg u256 x) -> reg u256 {
    // (no instruction)
    x = x << 0;
    return x;
}

// Different variables that register allocation merges: also nothing.
export
fn shr_0_merged(reg u256 x) -> reg u256 {
    // (no instruction)
    reg u256 z;
    z = x >> 0;
    return z;
}

// The amount is a u8 literal and wraps modulo 256 like any other u8 literal:
// 256 is 0 (a move, removed here), 264 is 8.
export
fn shr_wraps_to_zero(reg u256 x) -> reg u256 {
    // (no instruction)
    x = x >> 256;
    return x;
}

export
fn shl_wraps(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi w0, w0, t >> 248
    x = x << 264;
    return x;
}

// Two shifts in a row reuse the fresh register.
export
fn shr_then_shl(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi w0, t, w0 >> 8
    // bn.xor t, t, t, FG1 ; bn.rshi w0, w0, t >> 240
    x = x >> 8;
    x = x << 16;
    return x;
}

// The source stays live after the shift.
export
fn shr_keeps_source(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi z, t, w0 >> 8 ; bn.add w0, w0, z, FG1
    reg u256 z;
    z = x >> 8;
    x = x + z;
    return x;
}

// A lowered comparison (on FG1) next to a lowered shift (set0 writes FG1).
export
fn shift_then_select(reg u256 a, reg u256 b) -> reg u256 {
    // bn.xor t, t, t, FG1 ; bn.rshi z, t, w1 >> 8
    // bn.cmp w0, z, FG1 ; bn.sel w0, w0, w1, FG1.C
    reg u256 z;
    z = b >> 8;
    a = b if !(a <u z);
    return a;
}

// Hand-written shifts that take the zero register as an argument, for callers
// that already have one (no #set0_256 inside the shift).
// The amount must be a constant once inlined. As for the lowered shifts, it
// wraps modulo 256 (256 is 0, 264 is 8).
//   shr:  z = x >> i   is   z = #BN_RSHI(zero, x, i)
//   shl:  z = x << i   is   z = #BN_RSHI(x, zero, 256 - i)
// (the u8 amount of the intrinsic wraps modulo 256 by itself)
// A shift by 0 (mod 256) is a move in both (for shl it is required: BN.RSHI
// by 256 - 0 would wrap to 0 and return the zero register; for shr it lets
// the move disappear when source and destination share a register).
inline
fn shr_zero(reg u256 x zero, inline int i) -> reg u256 {
    reg u256 z;
    if (i % 256 == 0) {
        z = x;
    } else {
        z = #BN_RSHI(zero, x, i);
    }
    return z;
}

inline
fn shl_zero(reg u256 x zero, inline int i) -> reg u256 {
    reg u256 z;
    if (i % 256 == 0) {
        z = x;
    } else {
        z = #BN_RSHI(x, zero, 256 - i);
    }
    return z;
}

export
fn use_shr_zero(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG0 ; bn.rshi w0, t, w0 >> 8
    reg u256 zero;
    ?{}, zero = #set0_256();
    x = shr_zero(x, zero, 8);
    return x;
}

export
fn use_shl_zero(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG0 ; bn.rshi w0, w0, t >> 248
    reg u256 zero;
    ?{}, zero = #set0_256();
    x = shl_zero(x, zero, 8);
    return x;
}

export
fn use_shift_zero_shared(reg u256 x) -> reg u256 {
    // one zero register serves all shifts; the shifts by 0 are moves
    // bn.xor t, t, t, FG0
    // bn.rshi w0, t, w0 >> 4 ; bn.rshi w0, w0, t >> 252 ; (shifts by 0: nothing)
    reg u256 zero;
    ?{}, zero = #set0_256();
    x = shr_zero(x, zero, 4);
    x = shl_zero(x, zero, 4);
    x = shr_zero(x, zero, 0);
    x = shl_zero(x, zero, 0);
    x = shr_zero(x, zero, 256);
    x = shl_zero(x, zero, 256);
    return x;
}

export
fn use_shift_zero_wraps(reg u256 x) -> reg u256 {
    // bn.xor t, t, t, FG0
    // bn.rshi w0, t, w0 >> 8 ; bn.rshi w0, w0, t >> 248
    reg u256 zero;
    ?{}, zero = #set0_256();
    x = shr_zero(x, zero, 264);
    x = shl_zero(x, zero, 264);
    return x;
}
