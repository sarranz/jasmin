// assume_call_depth on an instruction overrides the analysis of that call: the
// checker takes the annotated value without looking at the callee.
//
// Same nine-deep chain as the function-level test, but here the annotation sits
// on the call instruction inside f5 rather than on f5 itself.  The call to f6
// is counted as 0, so f5=0, f4=1, ..., f1=4, main=5.
fn f9(reg u32 x) -> reg u32 { x += 1; return x; }
fn f8(reg u32 x) -> reg u32 { x = f9(x); return x; }
fn f7(reg u32 x) -> reg u32 { x = f8(x); return x; }
fn f6(reg u32 x) -> reg u32 { x = f7(x); return x; }

fn f5(reg u32 x) -> reg u32 {
    #[assume_call_depth=0]
    x = f6(x);
    return x;
}

fn f4(reg u32 x) -> reg u32 { x = f5(x); return x; }
fn f3(reg u32 x) -> reg u32 { x = f4(x); return x; }
fn f2(reg u32 x) -> reg u32 { x = f3(x); return x; }
fn f1(reg u32 x) -> reg u32 { x = f2(x); return x; }

export
fn main(reg u32 x) -> reg u32 {
    x = f1(x);
    return x;
}
