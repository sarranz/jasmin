fn inner(reg u32 x) -> reg u32 {
    repeat 2 {
      repeat 2 {
        repeat 2 {
          repeat 2 {
            x += 1;
          }
        }
      }
    }
    return x;
}

export
fn main(reg u32 x) -> reg u32 {
    repeat 2 {
      repeat 2 {
        repeat 2 {
          repeat 2 {
            x = inner(x);
          }
        }
      }
    }
    return x;
}
