export
fn wsr(reg u256 x) -> reg u256 {
    reg u256 acc;
    acc = #BN_ACCW(x);
    x = #BN_ACCR(acc);
    return x;
}

// ACCH is the high half of the 512-bit accumulator of BN.MULV.
export
fn wsr_acch(reg u256 x) -> reg u256 {
    reg u256 acch;
    acch = #BN_ACCHW(x);
    x = #BN_ACCHR(acch);
    return x;
}

// KMAC: the configuration write starts a computation, message writes thread
// KMAC_MSG and produce KMAC_DIG, digest reads thread KMAC_DIG.
export
fn wsr_kmac(reg u256 cfg msg0 msg1, reg u32 pw) -> reg u256 {
    reg u256 kcfg kmsg kdig x y;
    reg u32 kpw;
    kcfg, kmsg, kdig = #BN_KMAC_CFGW(cfg);
    kpw = #KMAC_PARTIAL_WRITEW(pw);
    kmsg, kdig = #BN_KMAC_MSGW(kcfg, kmsg, kpw, msg0);
    kmsg, kdig = #BN_KMAC_MSGW(kcfg, kmsg, kpw, msg1);
    x, kdig = #BN_KMAC_DIGR(kdig);
    y, kdig = #BN_KMAC_DIGR(kdig);
    ?{}, x = #BN_XOR(x, y);
    return x;
}
