param int N = 43;

u32[4] g = { 0x1, 0x2, 0x3, 0x4 };

fn body(reg u32 x) -> reg u32 {
    x += 1;
    return x;
}

export
fn main() -> reg u32 {
    reg u32 x;
    x = 0;

    repeat 4 { x = body(x); }
    repeat N { x = body(x); }
    repeat (uint)x { x = body(x); }
    repeat (4 + N) { x = body(x); }

    inline int i;
    for i = 0 to 2 {
        repeat i { x = body(x); }
    }

    return x;
}

export
fn empty() -> reg u32 {
    reg u32 x;
    x = 0;

    repeat 4 { }
    repeat N { }
    repeat x { }
    repeat (4 + N) { }

    inline int i;
    for i = 0 to 2 {
        repeat i { }
    }

    x = 4;
    while (x != 0) {
        repeat x { }
        x -= 1;
    }
    return x;
}

// if/else at end of body: loop body ends with a LABEL (merge point) -> nop inserted
export
fn cond_at_end(reg u32 x) -> reg u32 {
    repeat 4 {
        if (x == 0) {
            x += 1;
        } else {
            x += 2;
        }
    }
    return x;
}

// if/else NOT at end: last instruction is an addi -> no nop from LABEL
export
fn cond_not_at_end(reg u32 x) -> reg u32 {
    repeat 4 {
        if (x == 0) {
            x += 1;
        } else {
            x += 2;
        }
        x += 3;
    }
    return x;
}

// if without else at end: body ends with a LABEL -> nop inserted
export
fn if_only_at_end(reg u32 x) -> reg u32 {
    repeat 4 {
        if (x != 0) {
            x += 1;
        }
    }
    return x;
}

// nested loops where inner loop is last: body ends with REPEATLOOP -> nop inserted
// (ACC forbids two loops sharing their last instruction address)
export
fn nested_inner_last(reg u32 x) -> reg u32 {
    repeat 4 {
        repeat 3 {
            x += 1;
        }
    }
    return x;
}

// nested loops with an instruction after the inner loop: no nop from REPEATLOOP
export
fn nested_inner_not_last(reg u32 x) -> reg u32 {
    repeat 4 {
        repeat 3 {
            x += 1;
        }
        x += 1;
    }
    return x;
}

// three levels of nesting: two nops inserted (one per level where inner loop is last)
export
fn triple_nested(reg u32 x) -> reg u32 {
    repeat 2 {
        repeat 3 {
            repeat 4 {
                x += 1;
            }
        }
    }
    return x;
}

// two sequential inner loops where the second (last) is at the end -> nop from REPEATLOOP
export
fn two_inner_second_last(reg u32 x) -> reg u32 {
    repeat 4 {
        repeat 2 { x += 1; }
        repeat 3 { x += 2; }
    }
    return x;
}

// two sequential inner loops with a tail instruction -> no nop from REPEATLOOP
export
fn two_inner_with_tail(reg u32 x) -> reg u32 {
    repeat 4 {
        repeat 2 { x += 1; }
        repeat 3 { x += 2; }
        x += 4;
    }
    return x;
}

// register-count loop with conditional body: LABEL at end -> nop inserted
export
fn reg_count_cond_at_end(reg u32 x, reg u32 n) -> reg u32 {
    repeat (uint)n {
        if (x == 0) {
            x += 1;
        } else {
            x += 2;
        }
    }
    return x;
}

// while inside repeat: loop body ends with a backward Jcc -> no nop from LABEL/REPEATLOOP
export
fn while_in_repeat(reg u32 x, reg u32 y) -> reg u32 {
    repeat 4 {
        while (x != y) {
            x += 1;
        }
    }
    return x;
}

// nested loops where inner body has a conditional: inner ends with LABEL -> nop in inner;
// outer ends with REPEATLOOP -> nop in outer
export
fn nested_with_cond(reg u32 x) -> reg u32 {
    repeat 3 {
        repeat 5 {
            if (x == 0) {
                x += 1;
            } else {
                x += 2;
            }
        }
    }
    return x;
}

// LA at the end of the loop body: LA assembles to two real instructions, so
// the body's true instruction count is 4 (lw, add, and the two halves of
// la), not 3. This does not fail to compile or assemble but without counting
// LA as 2, the count would be off by one and the second half of LA
// (the loop's actual last instruction) would fall outside the hardware loop's
// repeated window.
export
fn la_last_in_loop(reg u32 n) -> reg u32 {
    reg ptr u32[4] p;
    reg u32 res tmp;
    res = 0;
    p = g;
    repeat n {
        tmp = p[#aligned 0];
        res += tmp;
        p = g;
    }
    return res;
}

// LI with an immediate that does not fit in 12 signed bits at the end of the
// loop body: LI assembles to lui + addi, so it must count as 2 (like LA
// above). The body is add + the two halves of li = 3, not 2.
export
fn li_large_last_in_loop(reg u32 n, reg u32 tmp) -> reg u32 {
    reg u32 res;
    res = 0;
    repeat n {
        res += tmp;
        tmp = 0x12345;
    }
    return res;
}

// LI with an immediate that fits in 12 signed bits assembles to a single
// addi: the body is add + li = 2.
export
fn li_small_last_in_loop(reg u32 n, reg u32 tmp) -> reg u32 {
    reg u32 res;
    res = 0;
    repeat n {
        res += tmp;
        tmp = 2047;
    }
    return res;
}

// Boundaries of the 12-bit signed range: 2047 and -2048 (0xFFFFF800) are
// single instructions (addi), 2048 and -2049 (0xFFFFF7FF) are two each
// (lui + addi), and 4096 and -4096 (0xFFFFF000) are single instructions again
// (lui alone, since the low 12 bits are zero). The body is
// 6 adds + 1 + 2 + 1 + 2 + 1 + 1 = 14.
export
fn li_boundaries_in_loop(
    reg u32 n, reg u32 a, reg u32 b, reg u32 c, reg u32 d, reg u32 e, reg u32 f
) -> reg u32 {
    reg u32 res;
    res = 0;
    repeat n {
        res += a;
        res += b;
        res += c;
        res += d;
        res += e;
        res += f;
        a = 2047;
        b = 2048;
        c = 0xFFFFF800;
        d = 0xFFFFF7FF;
        e = 4096;
        f = 0xFFFFF000;
    }
    return res;
}

// LI whose immediate does not fit in 12 signed bits but has its low 12 bits
// zero assembles to a single lui: the body is add + li = 2, not 3. Counting
// it as 3 would pull the instruction after the loop into its body.
export
fn li_lui_only_last_in_loop(reg u32 n, reg u32 tmp) -> reg u32 {
    reg u32 res;
    res = 0;
    repeat n {
        res += tmp;
        tmp = 4096;
    }
    return res;
}

// Large LI at the start of the loop body, followed by two adds: the LI counts
// as 2, so the body is 4. (Adding the constant directly is rejected by
// lowering, hence the register detour.)
export
fn li_large_first_in_loop(reg u32 n) -> reg u32 {
    reg u32 res tmp;
    res = 0;
    repeat n {
        tmp = 0x12345;
        tmp += n;
        res += tmp;
    }
    return res;
}

// #declassify is printed as a comment, which takes no space: the body is 1
// (the addi), and no nop is needed since the last real instruction is the
// addi.
export
fn declassify_last_in_loop(reg u32 n, reg u32 x) -> reg u32 {
    repeat n {
        x += 1;
        #declassify(x);
    }
    return x;
}
