/* The suffix _wXX must match the value of the grd register: this is a safety
   condition that ensures the Jasmin semantics matches the hardware behaviour.
   BN.LID loads from memory into WDR[grd]; Jasmin models this as BN_LID_wXX
   where XX is the compile-time-known index, and grd must hold that value at
   runtime. */

export
fn bn_lid(reg u32 addr) -> reg u256 {
    reg u32 i;
    reg u256 x acc;
    ?{}, acc = #set0_256();
    i = 0;  x = #BN_LID_w00(i, [#aligned :u256 addr]); acc += x;
    i = 1;  x = #BN_LID_w01(i, [#aligned :u256 addr]); acc += x;
    i = 2;  x = #BN_LID_w02(i, [#aligned :u256 addr]); acc += x;
    i = 3;  x = #BN_LID_w03(i, [#aligned :u256 addr]); acc += x;
    i = 4;  x = #BN_LID_w04(i, [#aligned :u256 addr]); acc += x;
    i = 5;  x = #BN_LID_w05(i, [#aligned :u256 addr]); acc += x;
    i = 6;  x = #BN_LID_w06(i, [#aligned :u256 addr]); acc += x;
    i = 7;  x = #BN_LID_w07(i, [#aligned :u256 addr]); acc += x;
    i = 8;  x = #BN_LID_w08(i, [#aligned :u256 addr]); acc += x;
    i = 9;  x = #BN_LID_w09(i, [#aligned :u256 addr]); acc += x;
    i = 10; x = #BN_LID_w10(i, [#aligned :u256 addr]); acc += x;
    i = 11; x = #BN_LID_w11(i, [#aligned :u256 addr]); acc += x;
    i = 12; x = #BN_LID_w12(i, [#aligned :u256 addr]); acc += x;
    i = 13; x = #BN_LID_w13(i, [#aligned :u256 addr]); acc += x;
    i = 14; x = #BN_LID_w14(i, [#aligned :u256 addr]); acc += x;
    i = 15; x = #BN_LID_w15(i, [#aligned :u256 addr]); acc += x;
    i = 16; x = #BN_LID_w16(i, [#aligned :u256 addr]); acc += x;
    i = 17; x = #BN_LID_w17(i, [#aligned :u256 addr]); acc += x;
    i = 18; x = #BN_LID_w18(i, [#aligned :u256 addr]); acc += x;
    i = 19; x = #BN_LID_w19(i, [#aligned :u256 addr]); acc += x;
    i = 20; x = #BN_LID_w20(i, [#aligned :u256 addr]); acc += x;
    i = 21; x = #BN_LID_w21(i, [#aligned :u256 addr]); acc += x;
    i = 22; x = #BN_LID_w22(i, [#aligned :u256 addr]); acc += x;
    i = 23; x = #BN_LID_w23(i, [#aligned :u256 addr]); acc += x;
    i = 24; x = #BN_LID_w24(i, [#aligned :u256 addr]); acc += x;
    i = 25; x = #BN_LID_w25(i, [#aligned :u256 addr]); acc += x;
    i = 26; x = #BN_LID_w26(i, [#aligned :u256 addr]); acc += x;
    i = 27; x = #BN_LID_w27(i, [#aligned :u256 addr]); acc += x;
    i = 28; x = #BN_LID_w28(i, [#aligned :u256 addr]); acc += x;
    i = 29; x = #BN_LID_w29(i, [#aligned :u256 addr]); acc += x;
    i = 30; x = #BN_LID_w30(i, [#aligned :u256 addr]); acc += x;
    i = 31; x = #BN_LID_w31(i, [#aligned :u256 addr]); acc += x;

    return acc;
}
