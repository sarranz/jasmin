fn aux(reg ptr u32[2] out in) -> reg ptr u32[2] {
  reg u32[2] x y;
  x[0] = in[#aligned 0];
  x[1] = in[#aligned 1];
  y[0] = x[0] + x[1];
  y[1] = x[0] - x[1];
  out[#aligned 0] = y[0];
  out[#aligned 1] = y[1];
  return out;
}

export fn test(reg u32 t) -> reg u32 {
  stack u32[2] a b;
  inline int i;
  for i = 0 to 2 { a[#aligned i] = t; }
  b = aux(b, a);
  reg u32 res;
  res = 0;
  for i = 0 to 2 { t = b[#aligned i]; res |= t; }
  return res;
}
