export
fn test_bn_movr(reg u256 src) -> reg u256 {
    reg u32 grd;
    reg u32 grs;
    reg u256 x acc;
    ?{}, acc = #set0_256();
    src = src; grd = 0; grs = 1; x = bn_movr(src, grd, grs, 1, 0); acc += x;
    src = src; grd = 1; grs = 2; x = bn_movr(src, grd, grs, 2, 1); acc += x;
    src = src; grd = 2; grs = 3; x = bn_movr(src, grd, grs, 3, 2); acc += x;
    src = src; grd = 3; grs = 4; x = bn_movr(src, grd, grs, 4, 3); acc += x;
    src = src; grd = 4; grs = 5; x = bn_movr(src, grd, grs, 5, 4); acc += x;
    src = src; grd = 5; grs = 6; x = bn_movr(src, grd, grs, 6, 5); acc += x;
    src = src; grd = 6; grs = 7; x = bn_movr(src, grd, grs, 7, 6); acc += x;
    src = src; grd = 7; grs = 8; x = bn_movr(src, grd, grs, 8, 7); acc += x;
    src = src; grd = 8; grs = 9; x = bn_movr(src, grd, grs, 9, 8); acc += x;
    src = src; grd = 9; grs = 10; x = bn_movr(src, grd, grs, 10, 9); acc += x;
    src = src; grd = 10; grs = 11; x = bn_movr(src, grd, grs, 11, 10); acc += x;
    src = src; grd = 11; grs = 12; x = bn_movr(src, grd, grs, 12, 11); acc += x;
    src = src; grd = 12; grs = 13; x = bn_movr(src, grd, grs, 13, 12); acc += x;
    src = src; grd = 13; grs = 14; x = bn_movr(src, grd, grs, 14, 13); acc += x;
    src = src; grd = 14; grs = 15; x = bn_movr(src, grd, grs, 15, 14); acc += x;
    src = src; grd = 15; grs = 16; x = bn_movr(src, grd, grs, 16, 15); acc += x;
    src = src; grd = 16; grs = 17; x = bn_movr(src, grd, grs, 17, 16); acc += x;
    src = src; grd = 17; grs = 18; x = bn_movr(src, grd, grs, 18, 17); acc += x;
    src = src; grd = 18; grs = 19; x = bn_movr(src, grd, grs, 19, 18); acc += x;
    src = src; grd = 19; grs = 20; x = bn_movr(src, grd, grs, 20, 19); acc += x;
    src = src; grd = 20; grs = 21; x = bn_movr(src, grd, grs, 21, 20); acc += x;
    src = src; grd = 21; grs = 22; x = bn_movr(src, grd, grs, 22, 21); acc += x;
    src = src; grd = 22; grs = 23; x = bn_movr(src, grd, grs, 23, 22); acc += x;
    src = src; grd = 23; grs = 24; x = bn_movr(src, grd, grs, 24, 23); acc += x;
    src = src; grd = 24; grs = 25; x = bn_movr(src, grd, grs, 25, 24); acc += x;
    src = src; grd = 25; grs = 26; x = bn_movr(src, grd, grs, 26, 25); acc += x;
    src = src; grd = 26; grs = 27; x = bn_movr(src, grd, grs, 27, 26); acc += x;
    src = src; grd = 27; grs = 28; x = bn_movr(src, grd, grs, 28, 27); acc += x;
    src = src; grd = 28; grs = 29; x = bn_movr(src, grd, grs, 29, 28); acc += x;
    src = src; grd = 29; grs = 30; x = bn_movr(src, grd, grs, 30, 29); acc += x;
    src = src; grd = 30; grs = 31; x = bn_movr(src, grd, grs, 31, 30); acc += x;
    src = src; grd = 31; grs = 0; x = bn_movr(src, grd, grs, 0, 31); acc += x;

    return acc;
}
