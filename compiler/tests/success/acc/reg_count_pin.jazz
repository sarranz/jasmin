// Minimal program with a single register-count repeat loop, used by
// acc-loop.t to pin the guarded flat linear shape (Lcond guard, Lloop_begin,
// Llabel, body, Lloop_end, Llabel Lskip) from PLAN-acc-loop-impl.md's
// Stage 5 design.
export
fn reg_count_pin(reg u32 x, reg u32 n) -> reg u32 {
    repeat (uint)n {
        x += 1;
    }
    return x;
}
