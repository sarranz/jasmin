// check_max_loop_depth replaces, for this function, the default maximum loop
// nesting depth of 8.  main nests three repeat loops, within the custom limit
// of 4.  (Compare tests/fail/otbn/check_max_loop_depth.jazz, where the same
// shape is rejected with a limit of 2.)
#[check_max_loop_depth=4]
export
fn main(reg u32 x) -> reg u32 {
    repeat 2 {
      repeat 2 {
        repeat 2 {
          x += 1;
        }
      }
    }
    return x;
}
