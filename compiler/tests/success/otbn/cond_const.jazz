export
fn if_eq_const(reg u32 x) -> reg u32 {
    if (x == 5) {
        x += 1;
    } else {
        x += 2;
    }
    return x;
}

export
fn if_neq_const(reg u32 x) -> reg u32 {
    if (x != 7) {
        x += 1;
    }
    return x;
}

export
fn const_on_left(reg u32 x) -> reg u32 {
    if (42 == x) {
        x += 1;
    }
    return x;
}

export
fn while_neq_const(reg u32 x) -> reg u32 {
    while (x != 10) {
        x += 1;
    }
    return x;
}

// Does not fit in a 12-bit immediate: LI expands to lui + addi.
export
fn if_large_const(reg u32 x) -> reg u32 {
    if (x == 0x12345) {
        x += 1;
    }
    return x;
}

// Constant 0 is kept as the zero register (x0); no LI is emitted.
export
fn if_eq_zero(reg u32 x) -> reg u32 {
    if (x == 0) {
        x += 1;
    }
    return x;
}
