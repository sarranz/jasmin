// assume_call_depth on a function overrides the analysis of its body: the
// checker takes the annotated value without descending into the body.
//
// The chain main -> f1 -> ... -> f9 is nine calls deep and would overflow the
// depth-8 call stack.  Annotating f5 with assume_call_depth=0 tells the checker
// to treat f5 as if it made no calls, breaking the accumulation:
// f9=0, f8=1, ..., f6=3, f5=0 (assumed), f4=1, ..., f1=4, main=5.
fn f9(reg u32 x) -> reg u32 { x += 1; return x; }
fn f8(reg u32 x) -> reg u32 { x = f9(x); return x; }
fn f7(reg u32 x) -> reg u32 { x = f8(x); return x; }
fn f6(reg u32 x) -> reg u32 { x = f7(x); return x; }

#[assume_call_depth=0]
fn f5(reg u32 x) -> reg u32 { x = f6(x); return x; }

fn f4(reg u32 x) -> reg u32 { x = f5(x); return x; }
fn f3(reg u32 x) -> reg u32 { x = f4(x); return x; }
fn f2(reg u32 x) -> reg u32 { x = f3(x); return x; }
fn f1(reg u32 x) -> reg u32 { x = f2(x); return x; }

export
fn main(reg u32 x) -> reg u32 {
    x = f1(x);
    return x;
}
