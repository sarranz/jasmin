// check_max_call_depth replaces, for this function, the default maximum call
// depth of 8.  main -> f1 -> f2 is two calls deep, within the custom limit of
// 3.  (Compare tests/fail/otbn/check_max_call_depth.jazz, where the same shape
// is rejected with a limit of 1.)
fn f2(reg u32 x) -> reg u32 { x += 1; return x; }
fn f1(reg u32 x) -> reg u32 { x = f2(x); return x; }

#[check_max_call_depth=3]
export
fn main(reg u32 x) -> reg u32 {
    x = f1(x);
    return x;
}
