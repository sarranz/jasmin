// assume_loop_depth on a function overrides the analysis of its body.
//
// inner really nests four repeat loops, and main wraps five more around the
// call, so the true loop nesting is nine -- over the depth-8 loop stack.
// Annotating inner with assume_loop_depth=1 makes the checker treat inner as
// using a single loop level, so main is accounted as 5 + 1 = 6.  This is a
// trust annotation: the programmer asserts the bound and the checker does not
// verify it against the body.
#[assume_loop_depth=1]
fn inner(reg u32 x) -> reg u32 {
    repeat 2 {
      repeat 2 {
        repeat 2 {
          repeat 2 {
            x += 1;
          }
        }
      }
    }
    return x;
}

export
fn main(reg u32 x) -> reg u32 {
    repeat 2 {
      repeat 2 {
        repeat 2 {
          repeat 2 {
            repeat 2 {
              x = inner(x);
            }
          }
        }
      }
    }
    return x;
}
