// Positive test: nine nested loops, but one of them is a range (for) loop.
// Range loops are unrolled and do not use the OTBN hardware loop stack, so only
// the eight repeat loops count -- exactly the supported nesting depth of 8.
export
fn main(reg u32 n) -> reg u32 {
    reg u32 x;
    x = 0;
    inline int i;
    repeat n {
      repeat 3 {
        repeat n {
          repeat 3 {
            for i = 0 to 2 {
              repeat n {
                repeat 3 {
                  repeat n {
                    repeat 3 {
                      x += 1;
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    return x;
}
