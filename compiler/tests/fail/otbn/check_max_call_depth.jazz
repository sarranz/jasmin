// Negative: check_max_call_depth tightens the limit below the actual depth.
// main -> f1 -> f2 is two calls deep, but the limit for main is set to 1.  The
// failing function is main (f1, at depth 1, is within the default limit of 8).
fn f2(reg u32 x) -> reg u32 { x += 1; return x; }
fn f1(reg u32 x) -> reg u32 { x = f2(x); return x; }

#[check_max_call_depth=1]
export
fn main(reg u32 x) -> reg u32 {
    x = f1(x);
    return x;
}
