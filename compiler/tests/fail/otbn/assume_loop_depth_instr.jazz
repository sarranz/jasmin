// Negative: assume_loop_depth on an instruction forces an overflow.
// The repeat loop is asserted to nest nine deep, exceeding the depth-8 loop
// stack.  The failing function is main.
export
fn main(reg u32 x) -> reg u32 {
    #[assume_loop_depth=9]
    repeat 2 {
      x += 1;
    }
    return x;
}
