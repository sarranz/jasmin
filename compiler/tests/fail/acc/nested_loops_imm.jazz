export
fn main() -> reg u32 {
    reg u32 x;
    x = 0;
    repeat 2 {
      repeat 2 {
        repeat 2 {
          repeat 2 {
            repeat 2 {
              repeat 2 {
                repeat 2 {
                  repeat 2 {
                    repeat 2 {
                      x += 1;
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    return x;
}
