// Expected error (unverified -- no compiler run): acc_stack_zeroization.v's
// clear-step assertion, roughly:
//   Clear step u128 is not supported on ACC, only u32 and u256 are; set
//   "stackzerosize"
// (Table's shorthand: "ACC" only; the strategy "loop" is added here so the
// annotation actually reaches the zeroization pass -- see the note in
// stackzero_size_u64.jazz.)
#[stackzero=loop, stackzerosize=u128]
export
fn stackzero_size_u128(reg u256 x) -> reg u256 {
    stack u256 s;
    s = x;
    x = s;
    return x;
}
