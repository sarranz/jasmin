// Negative: assume_call_depth on an instruction forces an overflow.
// The call to leaf is asserted to use nine call-stack slots, which already
// exceeds the depth-8 call stack.  The failing function is main.
fn leaf(reg u32 x) -> reg u32 { x += 1; return x; }

export
fn main(reg u32 x) -> reg u32 {
    #[assume_call_depth=9]
    x = leaf(x);
    return x;
}
