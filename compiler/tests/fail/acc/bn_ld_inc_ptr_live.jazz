/* The updated pointer [q] and the input pointer [p] are the same explicit
   argument of [bn.ld], so register allocation must merge them. Both are live
   after the instruction (both are returned), so they conflict and the program
   is rejected. */

export
fn ptr_live(reg u32 p) -> reg u256, reg u32, reg u32 {
    reg u32 q;
    reg u256 x;

    x, q = #BN_LD_INC([#aligned :u256 p], p);

    return x, p, q;
}
