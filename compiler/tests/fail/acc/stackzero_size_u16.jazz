// Expected error (unverified -- no compiler run): acc_stack_zeroization.v's
// clear-step assertion, roughly:
//   Clear step u16 is not supported on ACC, only u32 and u256 are; set
//   "stackzerosize"
// (Table's shorthand: "ACC: clear step not supported".)
#[stackzero=loop, stackzerosize=u16]
export
fn stackzero_size_u16(reg u32 x) -> reg u32 {
    stack u32 s;
    s = x;
    x = s;
    return x;
}
