// Return [rhi, rlo] = b ? [hi0, lo0] : [hi1, lo1].
inline
fn bn_sel512(reg u256 hi0 lo0 hi1 lo1, reg bool b) -> reg u256, reg u256 {
    reg u256 rlo rhi;
    rlo = b ? lo0 : lo1;
    rhi = b ? hi0 : hi1;
    return rhi, rlo;
}

// Return cf, [rhi, rlo] = [ahi, alo] + [bhi, blo].
inline
fn bn_add512(reg u256 ahi alo bhi blo) -> reg bool, reg u256, reg u256 {
    reg u256 rhi rlo;
    reg bool cf;
    cf, rlo = alo +256u blo;
    cf, rhi = ahi +256u bhi + cf;
    return cf, rhi, rlo;
}

// Return bf, [rhi, rlo] = [ahi, alo] - [bhi, blo].
inline
fn bn_sub512(reg u256 ahi alo bhi blo) -> reg bool, reg u256, reg u256 {
    reg u256 rhi rlo;
    reg bool bf;
    bf, rlo = alo -256u blo;
    bf, rhi = ahi -256u bhi - bf;
    return bf, rhi, rlo;
}

/* Unrolled 768=384x384 bit multiplication.

   Returns c = a x b.

   Flags: Last instruction performs a dummy addition on the highest limb of c.
   Therefore the routine is left with the flags being set based on this
   operation:
      - M: MSb of the result (and the highest limb of the result)
      - L: LSb of the highest limb of result
      - Z: Indicates if highest limb of result is zero
      - C: Never set

   Clobbered registers: ACC. */
fn mul384(
    reg u256 ahi alo,     // a, first operand, max. length 384 bit.
    reg u256 bhi blo,     // b, second operand, max. length 384 bit.
    reg u256 z,           // All-zero.
    reg u256 c2 c1 c0,    // Output registers.
    reg bool mf0 lf0 zf0) // FG0.
    ->
    reg u256, reg u256, reg u256, // c, result, max. length 768 bit.
    reg bool, reg bool, reg bool // FG0.M, FG0.L, FG0.Z flags
{
    reg u256 acc;

    acc = #BN_MULQACC_Z(alo, 0, blo, 0, 0);
    acc = #BN_MULQACC(alo, 0, blo, 1, acc, 64);
    ?{mf0, lf0, zf0, acc}, c0
         = #BN_MULQACC_SO_L(mf0, lf0, zf0, c0, alo, 1, blo, 0, acc, 64);
    acc = #BN_MULQACC(alo, 0, blo, 2, acc,  0);
    acc = #BN_MULQACC(alo, 1, blo, 1, acc,  0);
    acc = #BN_MULQACC(alo, 2, blo, 0, acc,  0);
    acc = #BN_MULQACC(alo, 0, blo, 3, acc, 64);
    acc = #BN_MULQACC(alo, 1, blo, 2, acc, 64);
    acc = #BN_MULQACC(alo, 2, blo, 1, acc, 64);
    ?{mf0, lf0, zf0, acc}, c0
         = #BN_MULQACC_SO_U(mf0, lf0, zf0, c0, alo, 3, blo, 0, acc, 64);

    acc = #BN_MULQACC(alo, 0, bhi, 0, acc,  0);
    acc = #BN_MULQACC(alo, 1, blo, 3, acc,  0);
    acc = #BN_MULQACC(alo, 2, blo, 2, acc,  0);
    acc = #BN_MULQACC(alo, 3, blo, 1, acc,  0);
    acc = #BN_MULQACC(ahi, 0, blo, 0, acc,  0);
    acc = #BN_MULQACC(alo, 0, bhi, 1, acc, 64);
    acc = #BN_MULQACC(alo, 1, bhi, 0, acc, 64);
    acc = #BN_MULQACC(alo, 2, blo, 3, acc, 64);
    acc = #BN_MULQACC(alo, 3, blo, 2, acc, 64);
    acc = #BN_MULQACC(ahi, 0, blo, 1, acc, 64);
    ?{mf0, lf0, zf0, acc}, c1
         = #BN_MULQACC_SO_L(mf0, lf0, zf0, c1, ahi, 1, blo, 0, acc, 64);
    acc = #BN_MULQACC(alo, 1, bhi, 1, acc,  0);
    acc = #BN_MULQACC(alo, 2, bhi, 0, acc,  0);
    acc = #BN_MULQACC(alo, 3, blo, 3, acc,  0);
    acc = #BN_MULQACC(ahi, 0, blo, 2, acc,  0);
    acc = #BN_MULQACC(ahi, 1, blo, 1, acc,  0);
    acc = #BN_MULQACC(alo, 2, bhi, 1, acc, 64);
    acc = #BN_MULQACC(alo, 3, bhi, 0, acc, 64);
    acc = #BN_MULQACC(ahi, 0, blo, 3, acc, 64);
    ?{mf0, lf0, zf0, acc}, c1
         = #BN_MULQACC_SO_U(mf0, lf0, zf0, c1, ahi, 1, blo, 2, acc, 64);

    acc = #BN_MULQACC(alo, 3, bhi, 1, acc,  0);
    acc = #BN_MULQACC(ahi, 0, bhi, 0, acc,  0);
    acc = #BN_MULQACC(ahi, 1, blo, 3, acc,  0);
    acc = #BN_MULQACC(ahi, 0, bhi, 1, acc, 64);
    ?{mf0, lf0, zf0, acc}, c2
         = #BN_MULQACC_SO_L(mf0, lf0, zf0, c2, ahi, 1, bhi, 0, acc, 64);
    ?{acc}, c2 = #BN_MULQACC_SO_U(mf0, lf0, zf0, c2, ahi, 1, bhi, 1, acc, 0);

    ?{mf0, lf0, zf0}, c2 = #BN_ADD(c2, z);

    return c2, c1, c0, mf0, lf0, zf0;
}

fn solinas_reduce(reg u256 c2 c1 c0 z) -> reg u256, reg u256 {
    // Constants for p = 2^384 - 2^128 - 1.
    reg u256 allones mask128;
    allones = !z;                          // 2^256 - 1
    mask128 = #BN_RSHI(z, allones, 128);   // 2^128 - 1  (= p_hi)

    // --- Round 1: fold the top 384 bits of the 768-bit product. -------------
    // clo = c[383:0]      -> (c1 & mask128, c0)
    // chi = c[767:384]    -> (c2 >> 128, [c2,c1] >> 128)
    reg u256 clo_hi chi_lo chi_hi;
    clo_hi = c1 &256u mask128;             // c[383:256]
    chi_lo = #BN_RSHI(c2, c1, 128);        // c[639:384]
    chi_hi = #BN_RSHI(z, c2, 128);         // c[767:640]

    // chi << 128 as a 512-bit value (chi < 2^384, so the shift fits in 512b).
    reg u256 chi2_lo chi2_hi;
    chi2_lo = #BN_RSHI(chi_lo, z, 128);    // (chi << 128)[255:0]
    chi2_hi = #BN_RSHI(chi_hi, chi_lo, 128); // (chi << 128)[511:256]

    // t1 = clo + chi + (chi << 128)   (< 2^513).
    reg bool cf;
    reg u256 t1hi t1lo;
    _,  t1hi, t1lo = bn_add512(clo_hi, c0, chi_hi, chi_lo);
    cf, t1hi, t1lo = bn_add512(t1hi, t1lo, chi2_hi, chi2_lo);

    // --- Round 2: fold bits [512:384] of t1 (t1 < 2^513). -------------------
    // t1 = thi*2^384 + tlo, with thi = (cf:t1hi) >> 128  (< 2^129).
    reg u256 cfreg th;
    _, cfreg = z +256u z + cf;             // carry-out bit as a 0/1 word
    th = #BN_RSHI(cfreg, t1hi, 128);       // t1 >> 384  (< 2^129)

    reg u256 tlo_hi;
    tlo_hi = t1hi &256u mask128;           // t1[383:256]

    // u = tlo + th + (th << 128)   (< 2^385).
    reg u256 th_lo th_hi u2hi u2lo;
    _, u2hi, u2lo = bn_add512(tlo_hi, t1lo, z, th);
    th_lo = #BN_RSHI(th, z, 128);          // (th << 128)[255:0]
    th_hi = #BN_RSHI(z, th, 128);          // th >> 128  (0 or 1)
    _, u2hi, u2lo = bn_add512(u2hi, u2lo, th_hi, th_lo);

    // --- Round 3: fold bit 384 of u (u < 2^385). ----------------------------
    // bit = u >> 384 in {0,1}; if set, add k = 2^128 + 1.
    reg u256 ubit selmask kconst addk;
    ubit = #BN_RSHI(z, u2hi, 128);         // u >> 384  (0 or 1)
    selmask = z -256u ubit;                // 0 or 0xff..ff
    kconst = mask128 +256u 2;              // (2^128 - 1) + 2 = 2^128 + 1
    addk = selmask &256u kconst;           // 0 or (2^128 + 1)

    reg u256 ulo_hi vhi vlo;
    ulo_hi = u2hi &256u mask128;           // u[383:256]
    _, vhi, vlo = bn_add512(ulo_hi, u2lo, z, addk);  // v < 2^384 + 2^129

    // --- Final reduction: subtract p = (mask128, p_lo) at most twice. -------
    reg u256 plo;
    plo = allones -256u kconst;            // 2^256 - 1 - (2^128 + 1) = p_lo

    reg bool bf;
    reg u256 whi wlo;
    bf, whi, wlo = bn_sub512(vhi, vlo, mask128, plo);
    vhi, vlo = bn_sel512(vhi, vlo, whi, wlo, bf);   // bf => v < p, keep v

    bf, whi, wlo = bn_sub512(vhi, vlo, mask128, plo);
    reg u256 rhi rlo;
    rhi, rlo = bn_sel512(vhi, vlo, whi, wlo, bf);

    return rhi, rlo;
}

fn solinas384(
    reg u256 ahi alo,     // a, first operand, max. length 384 bit, a < p.
    reg u256 bhi blo,     // b, second operand, max. length 384 bit, b < p.
    reg u256 z,           // All-zero.
    reg u256 c2 c1 c0,    // Scratch / output registers.
    reg bool mf0 lf0 zf0) // Flags.
    -> reg u256, reg u256 // c, result, max. length 384 bit.
{
    c2, c1, c0, mf0, lf0, zf0 = mul384(ahi, alo, bhi, blo, z, c2, c1, c0, mf0, lf0, zf0);

    reg u256 chi clo;
    chi, clo = solinas_reduce(c2, c1, c0, z);
    return chi, clo;
}

inline
fn _main(reg u256 ahi alo bhi blo) -> reg u256, reg u256 {
    reg u256 c2 c1 c0 z;
    reg bool mf0 lf0 zf0;
    ?{}, c2 = #set0_256();
    ?{}, c1 = #set0_256();
    ?{}, c0 = #set0_256();
    ?{mf0, lf0, zf0}, z = #set0_256();

    reg u256 chi clo;
    chi, clo = solinas384(ahi, alo, bhi, blo, z, c2, c1, c0, mf0, lf0, zf0);

    chi = chi;
    clo = clo;

    return chi, clo;
}

export
fn main(reg u256 ahi alo bhi blo) -> reg u256, reg u256 {
    reg u256 chi clo;
    chi, clo = _main(ahi, alo, bhi, blo);
    return chi, clo;
}


// -----------------------------------------------------------------------------
// Mock

// These bytes, in the .data section, will be overwritten by the main core:
// that's how it passes arguments to OTBN.  Each 384-bit operand is stored as
// (lo 256 bits, hi 128 bits) in two 32-byte slots.  Here a, b are two operands
// below p; [mock] reads them from memory and returns a * b mod p.
u64[4 * 4] data =
    {
        0x2233445566778899, 0xaabbccddeeff0011, 0xbaadf00d12345678, 0xdeadbeefcafef00d, // alo
        0x0123456789abcdef, 0x8000000000000000, 0x0,                0x0,                // ahi
        0x99887766554433ff, 0xcc2211ffeeddbbaa, 0x556677889900aabb, 0xc0ffee0011223344, // blo
        0x00fedcba98765432, 0x4000000000000000, 0x0,                0x0                 // bhi
    };

export
fn mock() -> reg u256, reg u256 {
    reg ptr u256[4] p;
    p = data;

    reg u256 alo ahi blo bhi;
    alo = p[#aligned 0];   // a[255:0]
    ahi = p[#aligned 1];   // a[383:256]
    blo = p[#aligned 2];   // b[255:0]
    bhi = p[#aligned 3];   // b[383:256]

    reg u256 chi clo;
    chi, clo = _main(ahi, alo, bhi, blo);

    return chi, clo;
}

//exec mock()
