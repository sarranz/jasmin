/*
 * Gimli permutation for OTBN, using only the base (RISC-V) instructions of the
 * ISA -- no wide BN.* instructions.
 *
 * OTBN's base instruction set is a 32-bit RISC-V (RV32I-like) core, so this is
 * essentially the RISC-V implementation: state lives in a u32[12] array indexed
 * with lw/sw, and the round logic uses add/xor/and/or/shift. OTBN has no native
 * rotate instruction, so the column rotations are built from two shifts and an
 * or (see ror32 below), exactly as on RISC-V.
 *
 * Compile with: jasminc -arch otbn gimli.jazz -o gimli.s
 */

param int N_ROUND = 24;
param int N_COLUMN = 4;
param int ROUND_CONSTANT = 0x9e377900;

inline
fn swap(reg ptr u32[12] state, inline int i, inline int j) -> reg ptr u32[12] {
    reg u32 x = state[#aligned i];
    reg u32 y = state[#aligned j];
    state[#aligned i] = y;
    state[#aligned j] = x;

    return state;
}

/* Rotate `in` left by `cnt` bits. OTBN's base ISA has no rotate, so we emit a
   pair of shifts and an or. */
inline fn ror32(reg u32 in, inline int cnt) -> reg u32 {
    reg u32 u = in << cnt;
    reg u32 l = in >> (32 - cnt);
    reg u32 ret = u | l;
    return ret;
}

export
fn gimli(reg ptr u32[12] state) -> reg ptr u32[12] {
    inline int round, column;

    reg u32 rc = ROUND_CONSTANT;

    for round = N_ROUND downto 0 {
        for column = 0 to N_COLUMN {
            reg u32 x = state[#aligned 0 + column];
            x = ror32(x, 24);
            reg u32 y = state[#aligned 4 + column];
            y = ror32(y, 9);
            reg u32 z = state[#aligned 8 + column];

            reg u32 tmp = z << 1;
            reg u32 a = x ^ tmp;
            reg u32 b = y & z;
            tmp = b << 2;
            a ^= tmp;
            state[#aligned 8 + column] = a;

            a = y ^ x;
            b = x | z;
            tmp = b << 1;
            a ^= tmp;
            state[#aligned 4 + column] = a;

            a = z ^ y;
            b = x & y;
            tmp = b << 3;
            a ^= tmp;
            state[#aligned 0 + column] = a;
        }

        if (round % 4 == 0) {
            state = swap(state, 0, 1);
            state = swap(state, 2, 3);
        }

        if (round % 4 == 2) {
            state = swap(state, 0, 2);
            state = swap(state, 1, 3);
        }

        if (round % 4 == 0) {
            reg u32 a = state[#aligned 0];
            reg u32 b = rc + round;
            a ^= b;
            state[#aligned 0] = a;
        }
    }
    return state;
}
