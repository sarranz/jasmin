[default]

[test-x86-64-nolea]
bin    = ./scripts/check
args   = -arch x86-64 -nolea
kodirs = tests/fail/nolea/x86-64

[test-CCT]
bin    = ./jasmin-ct
okdirs = CCT/success
kodirs = CCT/fail
exclude = CCT/success/doit CCT/fail/doit

[test-CCT-DOIT]
bin    = ./jasmin-ct
args = --doit
okdirs = CCT/success/doit
kodirs = CCT/fail/doit

[test-SCT]
bin    = ./jasmin-ct
args = --speculative --after=rmfunc
okdirs = CCT/success/speculative

[test-x86-64-ATT]
bin     = ./scripts/check
args    = -arch x86-64 -ATT
okdirs  = examples/**/x86-64 tests/success/**/x86-64 tests/success/**/common

[test-x86-64-Intel]
bin = ./scripts/check
args = -arch x86-64 -intel
okdirs = examples/**/x86-64 tests/success/**/x86-64 tests/success/**/common

[test-x86-64-extraction]
bin = ./scripts/extract-and-check
args = x86-64
okdirs = examples/**/x86-64 tests/success/**/x86-64 tests/success/**/common
exclude = tests/success/noextract

[test-arm-m4]
bin = ./scripts/check
args = -arch arm-m4
okdirs = examples/**/arm-m4 tests/success/**/arm-m4 tests/success/**/common

[test-arm-m4-extraction]
bin = ./scripts/extract-and-check
args = arm
okdirs = examples/**/arm-m4 tests/success/**/arm-m4 tests/success/**/common
exclude = tests/success/noextract

[test-risc-v]
bin = ./scripts/check
args = -arch riscv
okdirs = examples/**/risc-v tests/success/**/risc-v tests/success/**/common

[test-risc-v-extraction]
bin = ./scripts/extract-and-check
args = riscv
okdirs = examples/**/risc-v tests/success/**/risc-v tests/success/**/common
exclude = tests/success/noextract

[test-otbn]
bin = ./scripts/check-otbn
okdirs = examples/**/otbn tests/success/**/otbn tests/success/**/common
kodirs = tests/fail/**/otbn
exclude = tests/success/common/assertion.jazz tests/success/common/autospill.jazz tests/success/common/bug_1145.jazz tests/success/common/bug_1292.jazz tests/success/common/bug_483.jazz tests/success/common/varalreadyset.jazz tests/success/common/wint.jazz tests/success/common/bug_499.jazz tests/success/common/renaming.jazz tests/success/common/unaligned.jazz tests/success/common/unaligned_subarray.jazz tests/success/common/inline.jazz

[test-x86-64-stack-zero-loop]
bin     = ./scripts/check
args    = -arch x86-64 -stack-zero=loop
okdirs  = tests/success/stack_zeroization/**/x86-64

[test-x86-64-stack-zero-unrolled]
bin     = ./scripts/check
args    = -arch x86-64 -stack-zero=unrolled
okdirs  = tests/success/stack_zeroization/**/x86-64

[test-arm-m4-stack-zero-loop]
bin     = ./scripts/check
args    = -arch arm-m4 -stack-zero=loop
okdirs  = tests/success/stack_zeroization/**/arm-m4

[test-arm-m4-stack-zero-unrolled]
bin     = ./scripts/check
args    = -arch arm-m4 -stack-zero=unrolled
okdirs  = tests/success/stack_zeroization/**/arm-m4

[test-risc-v-stack-zero-loop]
bin     = ./scripts/check
args    = -arch riscv -stack-zero=loop
okdirs  = tests/success/stack_zeroization/**/risc-v

[test-risc-v-stack-zero-unrolled]
bin     = ./scripts/check
args    = -arch riscv -stack-zero=unrolled
okdirs  = tests/success/stack_zeroization/**/risc-v

