fn foo(reg ptr u64[1] a, reg u64 v) -> reg ptr u64[1] {
  a[0] = v; // a from 0 to 8
  return a;
}

export fn main(reg u64 arg) -> reg u64 {
  stack u64[4] p q;
  p[0] = 1;
  q[0] = 2;

  reg u64 r = 0;

  reg ptr u64[1] x;

  if (arg == 0) { x = p[r:1]; } else { x = q[r:1]; }
  x = foo(x, r);
  if (arg == 0) { p[r:1] = x; } else { q[r:1] = x; }

  r = p[0];
  r += q[0];

  x = r;

  return r;
}

