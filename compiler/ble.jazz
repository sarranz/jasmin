param int N = 4;

export
fn masked_xor(reg ptr u32[N] c a b) -> reg ptr u32[N] {
    inline int i;
    reg u32[N] x;
    reg u32[N] y;

    x[0] = a[0];
    y[0] = b[0];
    x[0] ^= y[0];
    c[0] = x[0];

    for i = 1 to N {
        #[delayconstprop]
        if (true) {
            x[i] = a[i];
            y[i] = b[i];
        } else {
            x[i] = y[i-1]; // not in binary, but forces allocation
            y[i] = x[i-1]; // not in binary, but forces allocation
        }
        x[i] ^= y[i];
        c[i] = x[i];
    }
    return c;
}

