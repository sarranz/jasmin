fn foo(reg ptr u64[2] a1, reg u64 x1) -> reg ptr u64[2] {
  stack u64 s1 = x1;
  x1 = s1;
  a1[0] = x1;
  a1[1] = 0;
  return a1;
}

export fn main(reg ptr u64[2] a) -> reg ptr u64[2] {
  reg u64 x = a[0];
  reg ptr u64[2] b = foo(a, x);
  b[0] = 0;
  a = b;
  return a;
}

